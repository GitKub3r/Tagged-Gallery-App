# Configuración del servidor
PORT=3000
NODE_ENV=development

# Configuración de la base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tagged

# Configuración JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Firma de URLs de archivos subidos (/api/v1/files). Si no se define, se usa JWT_SECRET.
MEDIA_URL_SIGNING_SECRET=your_media_url_signing_secret_change_in_production

# CORS
# Se pueden separar varios origenes con coma.
CORS_ORIGIN=http://localhost:5173

# Google Drive (opcional). Ver README: configuración de Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave de API restringida a la Google Picker API y número del proyecto de Google Cloud
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# Cifrado del refresh token: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
